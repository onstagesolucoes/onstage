        [{ "node": "NIBO - Confirmar Entrega Manual do Protocolo", "type": "main", "index": 0 }]
      ]
    },
    "NIBO - Confirmar Entrega Manual do Protocolo": {
      "main": [[{ "node": "Normalizar Confirmação", "type": "main", "index": 0 }]]
    },
    "Normalizar Confirmação": {
      "main": [[{ "node": "Confirmado?", "type": "main", "index": 0 }]]
    },
    "Confirmado?": {
