    {
      "parameters": {
        "jsCode": "const resp = $json;\nconst arr = Array.isArray(resp) ? resp : (resp ? [resp] : []);\nconst existente = arr[0] || null;\nconst dados = $('Normalizar Cliente').item.json;\n\nreturn [{\n  json: {\n    ...dados,\n    jaEnviado: !!(existente && existente.status !== 'erro'),\n  },\n}];"
