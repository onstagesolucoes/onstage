      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-2720, 80],
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notes": "Mesmo projeto/tabela `clientes` já usados no fluxo OneFlow -> Nibo. Requer coluna conexa_customer_id (migration 001)."
    },
    {
      "parameters": {
        "jsCode": "const resp = $json;\nconst arr = Array.isArray(resp) ? resp : (resp ? [resp] : []);\nconst cliente = arr[0] || null;\nconst dados = $('Extrair Dados do Webhook').item.json;\n\nreturn [{\n  json: {\n    ...dados,\n    encontrado: !!cliente,\n    ativo: cliente ? cliente.ativo !== false : false,\n    cnpj: cliente ? cliente.cnpj : null,\n    nomeClienteCadastro: cliente ? cliente.nome_cliente : null,\n    clickupListId: cliente ? cliente.clickup_list_id : null,\n  },\n}];"
      },
