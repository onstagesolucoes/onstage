      "parameters": {
        "jsCode": "const dados = $('Normalizar Idempotência').item.json;\nconst nibo = $('NIBO - Criar Arquivo').item.json;\nconst clickup = $json;\n\nreturn [{\n  json: {\n    cnpj: dados.cnpj,\n    conexa_invoice_id: dados.conexaInvoiceId,\n    nibo_file_id: nibo.id ?? null,\n    clickup_task_id: clickup.id ?? null,\n    status: 'enviado',\n    error_message: null,\n    sent_at: new Date().toISOString(),\n  },\n}];"
